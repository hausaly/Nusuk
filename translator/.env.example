PORT=3100
# Persistent folder for the database, uploads and uploaded artwork (outside public_html on cPanel)
DATA_DIR=./data
# First-run administrator (created once, only if there are no users yet)
ADMIN_EMAIL=admin@hausaly.com
ADMIN_PASSWORD=
# Mount point: https://www.hausaly.com/trl
BASE_PATH=/trl
HTTPS=1
# Optional: random text used to encrypt API keys saved from the admin page (otherwise a key file is created in DATA_DIR)
APP_SECRET=
# Optional: API keys can also be set here instead of Admin -> AI Engines
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MAX_UPLOAD_MB=10
MAX_PAGES=12
