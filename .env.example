# Copy to .env (or export in your hosting dashboard)
PORT=3000
# Where the SQLite database lives (mount a persistent volume here in production)
DATA_DIR=./data
# First-run administrator. If unset, a random password is generated and printed once.
ADMIN_EMAIL=admin@nusuk.com.ng
ADMIN_PASSWORD=
# Set to 1 when served over HTTPS (marks the session cookie Secure and trusts X-Forwarded-*)
HTTPS=0
# Optional: POST a JSON summary here whenever a new request/booking arrives (Slack/Make/Zapier etc.)
NOTIFY_WEBHOOK_URL=
